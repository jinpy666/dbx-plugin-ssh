{
  "name": "git",
  "description": "Distributed version control system",
  "options": [
    { "names": ["--version"], "description": "Print the git suite version" },
    { "names": ["--help"], "description": "Show help for a command" },
    { "names": ["--no-pager"], "description": "Do not pipe output into a pager", "isPersistent": true },
    { "names": ["-C"], "description": "Run as if git was started in <path>", "args": { "name": "path" }, "isPersistent": true },
    { "names": ["--git-dir"], "description": "Set the path to the repository", "args": { "name": "path" }, "isPersistent": true }
  ],
  "subcommands": [
    {
      "name": "status",
      "description": "Show the working tree status",
      "options": [
        { "names": ["-s", "--short"], "description": "Give the output in the short-format" },
        { "names": ["-b", "--branch"], "description": "Show branch and tracking info in short format" },
        { "names": ["--porcelain"], "description": "Stable machine-readable output" }
      ]
    },
    {
      "name": "checkout",
      "aliases": ["co"],
      "description": "Switch branches or restore working tree files",
      "options": [
        { "names": ["-b", "--branch"], "description": "Create and switch to a new branch", "args": { "name": "name" } },
        { "names": ["-B", "--force-branch"], "description": "Create or reset and switch to a branch", "args": { "name": "name" } },
        { "names": ["--orphan"], "description": "New unborn branch", "args": { "name": "name" } },
        { "names": ["-t", "--track"], "description": "Set upstream for the new branch" },
        { "names": ["--detach"], "description": "Detach HEAD at the named commit" },
        { "names": ["--ours"], "description": "Conflicts: check out our version" },
        { "names": ["--theirs"], "description": "Conflicts: check out their version" },
        { "names": ["-f", "--force"], "description": "Throw away local changes" },
        { "names": ["-p", "--patch"], "description": "Interactively select hunks" }
      ],
      "args": [
        { "name": "branch", "description": "Branch to switch to", "generators": [{ "kind": "script", "script": ["git branch --format %(refname:short)"], "splitOn": "\n" }] },
        { "name": "tree-ish", "description": "Tree-ish to restore", "isOptional": true }
      ]
    },
    {
      "name": "commit",
      "description": "Record changes to the repository",
      "options": [
        { "names": ["-m", "--message"], "description": "Use the given message", "args": { "name": "msg" } },
        { "names": ["-a", "--all"], "description": "Stage all tracked files before committing" },
        { "names": ["--amend"], "description": "Replace the tip of the current branch" },
        { "names": ["--no-edit"], "description": "Amend without editing the message" },
        { "names": ["-s", "--signoff"], "description": "Add Signed-off-by trailer" },
        { "names": ["--trailer"], "description": "Add a trailer line", "args": { "name": "trailer" }, "isRepeatable": true }
      ]
    },
    {
      "name": "cherry-pick",
      "description": "Apply the changes introduced by existing commits",
      "options": [
        { "names": ["--continue"], "description": "Continue after resolving conflicts" },
        { "names": ["--abort"], "description": "Cancel the operation" },
        { "names": ["-n", "--no-commit"], "description": "Apply changes without committing" }
      ],
      "args": [{ "name": "commit", "description": "Commit to cherry-pick", "generators": [{ "kind": "script", "script": ["git log --format %H %s"] }] }]
    },
    {
      "name": "log",
      "description": "Show commit history",
      "options": [
        { "names": ["--oneline"], "description": "One commit per line" },
        { "names": ["--graph"], "description": "Draw a text-based commit graph" },
        { "names": ["--all"], "description": "Pretend all refs are listed on the command line" },
        { "names": ["-p", "--patch"], "description": "Show the patch introduced by each commit" },
        { "names": ["-n", "--max-count"], "description": "Limit number of commits", "args": { "name": "count" } },
        { "names": ["--pretty"], "description": "Pretty-print the contents", "args": { "name": "format", "description": "Output format", "suggestions": ["oneline", "short", "medium", "full", "raw"] } }
      ],
      "args": [{ "name": "path", "description": "Limit to paths", "isVariadic": true, "isOptional": true }]
    },
    {
      "name": "add",
      "description": "Stage file contents to the working tree",
      "options": [
        { "names": ["-A", "--all"], "description": "Stage all known files plus new ones" },
        { "names": ["-u", "--update"], "description": "Stage only already-tracked files" },
        { "names": ["-p", "--patch"], "description": "Interactively choose hunks" },
        { "names": ["-n", "--dry-run"], "description": "Do not actually add files" },
        { "names": ["-f", "--force"], "description": "Allow adding otherwise-ignored files" }
      ],
      "args": [{ "name": "pathspec", "description": "Files to stage", "isVariadic": true, "generators": [{ "kind": "script", "script": ["git diff --name-only"] }] }]
    },
    {
      "name": "branch",
      "description": "List, create or delete branches",
      "options": [
        { "names": ["-a", "--all"], "description": "List remote-tracking and local branches" },
        { "names": ["-r", "--remotes"], "description": "List remote-tracking branches" },
        { "names": ["-d", "--delete"], "description": "Delete a fully merged branch" },
        { "names": ["-m", "--move"], "description": "Rename a branch", "args": { "name": "newname" } }
      ],
      "args": [{ "name": "branchname", "description": "Branch name" }]
    },
    {
      "name": "remote",
      "description": "Manage tracked repositories",
      "options": [{ "names": ["-v", "--verbose"], "description": "Show remote URLs" }],
      "subcommands": [
        {
          "name": "add",
          "description": "Add a remote",
          "options": [
            { "names": ["-t", "--track"], "description": "Track only the given branch", "args": { "name": "branch" } },
            { "names": ["-f", "--fetch"], "description": "Fetch the new remote immediately" }
          ],
          "args": [{ "name": "name", "description": "Remote name" }, { "name": "url", "description": "Remote URL" }]
        },
        { "name": "remove", "aliases": ["rm"], "description": "Remove a remote", "args": [{ "name": "name", "description": "Remote name" }] },
        { "name": "rename", "description": "Rename a remote", "args": [{ "name": "old" }, { "name": "new" }] },
        {
          "name": "set-url",
          "description": "Change the URL of a remote",
          "options": [
            { "names": ["--add"], "description": "Add a new URL instead of changing existing ones" },
            { "names": ["--push"], "description": "Manipulate push URLs instead of fetch URLs" }
          ],
          "args": [{ "name": "name", "description": "Remote name" }, { "name": "url", "description": "Remote URL", "isOptional": true }]
        },
        { "name": "show", "description": "Give information about a remote", "args": [{ "name": "name", "description": "Remote name" }] },
        { "name": "prune", "description": "Delete stale remote-tracking branches", "args": [{ "name": "name", "description": "Remote name" }] },
        { "name": "update", "description": "Fetch updates for remotes" }
      ]
    }
  ]
}
