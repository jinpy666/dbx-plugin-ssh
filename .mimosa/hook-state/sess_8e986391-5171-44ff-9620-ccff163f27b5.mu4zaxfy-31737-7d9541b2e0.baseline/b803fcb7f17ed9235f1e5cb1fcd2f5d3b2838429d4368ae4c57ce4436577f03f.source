name: SSH plugin CI

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

env:
  PLUGIN_CLI_VERSION: "0.1.3"
  # aws-lc-sys falls back to its bundled prebuilt NASM objects when the
  # assembler is missing on the MSVC toolchain; harmless on every other OS.
  AWS_LC_SYS_PREBUILT_NASM: "1"
  # Windows runners default python stdout to cp1252; the smoke script prints
  # Unicode (→, ✓) and would die on UnicodeEncodeError. UTF-8 mode is a no-op
  # on the other platforms.
  PYTHONUTF8: "1"

jobs:
  validate:
    name: Validate repository contracts
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.x"
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
      - run: python3 scripts/validate_repo.py
      - run: node scripts/connection-forms/verify.mjs

  frontend:
    name: Frontend checks
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
        with:
          version: 11.24.0
      # setup-node 的 pnpm 缓存需要 pnpm 已在 PATH 中，故置于 pnpm/action-setup 之后
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: pnpm
          cache-dependency-path: frontend/pnpm-lock.yaml
      - run: pnpm --dir frontend install --frozen-lockfile
      - run: pnpm --dir frontend typecheck
      - run: pnpm --dir frontend test
      - run: pnpm --dir frontend build
      - name: Committed ui/ output is fresh
        run: |
          if ! git diff --quiet -- ui/; then
            git diff --stat -- ui/
            echo "ui/ is stale: run 'pnpm --dir frontend build' and commit the output" >&2
            exit 1
          fi

  backend:
    name: Rust sidecar checks
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4
      - name: Install native dependencies
        run: sudo apt-get update && sudo apt-get install -y pkg-config libdbus-1-dev nasm
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: rustfmt, clippy
      - uses: Swatinem/rust-cache@v2
        with:
          workspaces: backend
          cache-on-failure: true
      - run: cargo fmt --manifest-path backend/Cargo.toml --check
      # -D warnings keeps new lints out; a stable-toolchain update that
      # introduces a new lint fails here and is fixed like any other red CI.
      - run: cargo clippy --locked --manifest-path backend/Cargo.toml --all-targets -- -D warnings
      - run: cargo test --locked --manifest-path backend/Cargo.toml

  windows-regression:
    name: Windows connection-config regression
    runs-on: windows-2022
    needs: [validate]
    defaults:
      run:
        shell: pwsh
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
      - uses: actions/setup-python@v5
        with:
          python-version: "3.x"
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: rustfmt
      - uses: Swatinem/rust-cache@v2
        with:
          workspaces: backend
          cache-on-failure: true
      - name: Validate connection form contract
        run: node scripts/connection-forms/verify.mjs
      - name: Check Rust formatting
        run: cargo fmt --manifest-path backend/Cargo.toml --check
      - name: Run native Windows backend regression tests
        run: cargo test --locked --manifest-path backend/Cargo.toml
      - name: Build and smoke the Windows sidecar
        run: |
          cargo build --locked --release --manifest-path backend/Cargo.toml
          python scripts/smoke_mcp.py --binary backend/target/release/dbx-plugin-ssh.exe

  ssh-smoke:
    name: SSH container smoke
    runs-on: ubuntu-24.04
    needs: [validate]
    steps:
      - uses: actions/checkout@v4
      - name: Install native dependencies
        run: sudo apt-get update && sudo apt-get install -y pkg-config libdbus-1-dev nasm
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
        with:
          workspaces: backend
          cache-on-failure: true
      # Same container recipe scripts/test.sh uses locally (linuxserver/
      # openssh-server): password auth, NOPASSWD sudo for the sudo capability
      # cases, TCP forwarding for tunnel semantics, AcceptEnv so the setEnv
      # round-trip verifies end to end instead of skipping.
      - name: Start OpenSSH test container
        run: |
          docker run -d --name dbx-ssh-test -p 2222:2222 \
            -e USER_NAME=sshuser -e USER_PASSWORD=DbxTest2026 \
            -e PASSWORD_ACCESS=true linuxserver/openssh-server
          # s6 init materializes /config/sshd/sshd_config on first boot;
          # fresh runners exec within ~0.3s, so wait for the file first.
          for i in $(seq 1 30); do
            docker exec dbx-ssh-test test -f /config/sshd/sshd_config 2>/dev/null && break
            sleep 2
          done
          docker exec dbx-ssh-test test -f /config/sshd/sshd_config
          docker exec dbx-ssh-test sh -c \
            'echo "sshuser ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/sshuser && chmod 440 /etc/sudoers.d/sshuser'
          docker exec dbx-ssh-test sh -c 'sed -i "s/^#\?AllowTcpForwarding.*/AllowTcpForwarding yes/" /config/sshd/sshd_config; grep -q "^AllowTcpForwarding yes" /config/sshd/sshd_config || echo "AllowTcpForwarding yes" >> /config/sshd/sshd_config; grep -q "^AcceptEnv DBX_SMOKE_ENV" /config/sshd/sshd_config || echo "AcceptEnv DBX_SMOKE_ENV" >> /config/sshd/sshd_config'
          docker restart dbx-ssh-test
          for i in $(seq 1 60); do
            (exec 3<>/dev/tcp/127.0.0.1/2222) 2>/dev/null && break
            sleep 2
          done
          (exec 3<>/dev/tcp/127.0.0.1/2222)
      - run: cargo build --locked --release --manifest-path backend/Cargo.toml
      - name: Sidecar smoke against the live container
        env:
          DBX_PLUGIN_SIDECAR: ${{ github.workspace }}/backend/target/release/dbx-plugin-ssh
        run: |
          python3 scripts/smoke_test.py
          python3 scripts/smoke_fs_test.py

  candidate:
    name: Package candidate (${{ matrix.target }})
    needs: [validate, frontend, backend]
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: linux
            runner: ubuntu-24.04
            target: linux-x64
            python: python3
          - os: linux
            runner: ubuntu-24.04-arm
            target: linux-arm64
            python: python3
          - os: macos
            runner: macos-15
            target: darwin-arm64
            python: python3
          - os: macos
            runner: macos-15-intel
            target: darwin-x64
            python: python3
          - os: windows
            runner: windows-2022
            target: windows-x64
            python: python
    runs-on: ${{ matrix.runner }}
    defaults:
      run:
        shell: bash
    env:
      SIDECAR_BINARY: backend/target/release/dbx-plugin-ssh${{ matrix.os == 'windows' && '.exe' || '' }}
    steps:
      - uses: actions/checkout@v4
      - name: Install native dependencies
        if: matrix.os == 'linux'
        run: sudo apt-get update && sudo apt-get install -y pkg-config libdbus-1-dev nasm
      - uses: pnpm/action-setup@v4
        with:
          version: 11.24.0
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: pnpm
          cache-dependency-path: frontend/pnpm-lock.yaml
      - uses: dtolnay/rust-toolchain@stable
      # rust-cache 的 key 自动包含 job 名与 matrix 值，五个 target 各自缓存；
      # 打包步骤的 CARGO_TARGET_DIR 也指向 backend/target，可一并复用。
      - uses: Swatinem/rust-cache@v2
        with:
          workspaces: backend
          cache-on-failure: true
      - run: pnpm --dir frontend install --frozen-lockfile
      - run: pnpm --dir frontend build
      - run: cargo build --locked --release --manifest-path backend/Cargo.toml
      - name: Offline MCP smoke
        run: ${{ matrix.python }} scripts/smoke_mcp.py --binary "$SIDECAR_BINARY"
      - run: npm install --global "@dbx-app/plugin-cli@${PLUGIN_CLI_VERSION}"
      - name: Package .dbxp candidate
        # CARGO_TARGET_DIR points the CLI's own cargo build at the warm
        # backend/target from the step above instead of a throwaway staging dir.
        env:
          DBX_PLUGIN_TARGET: ${{ matrix.target }}
          CARGO_TARGET_DIR: ${{ github.workspace }}/backend/target
          NO_COLOR: "1"
        run: dbx-plugin package .
      - uses: actions/upload-artifact@v4
        with:
          name: dbx-plugin-ssh-${{ matrix.target }}
          if-no-files-found: error
          path: |
            dist/*.dbxp
            dist/*.artifact.json

  candidates-check:
    name: Cross-target candidate checks
    needs: [candidate]
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4
      - uses: actions/download-artifact@v4
        with:
          pattern: dbx-plugin-ssh-*
          path: dist
          merge-multiple: true
      - run: python3 scripts/check_candidates.py dist --expect linux-x64,linux-arm64,darwin-arm64,darwin-x64,windows-x64
